# Optional: Scratch credentials for social_connect_session via path_to_env.
SCRATCH_USERNAME=
SCRATCH_PASSWORD=
# Or a session id from the scratchsessionsid browser cookie:
# SCRATCH_SESSION_ID=
# Optional: override session store location (default: ~/.local/share/scratch-mcp).
SCRATCH_MCP_DATA_DIR=/path/to/scratch-unified-mcp/.sessions
# Optional: goboscript/sb2gs binaries if not on PATH.
# GOBOSCRIPT_BIN=
# SB2GS_BIN=
# Optional: TurboWarp live-reload bridge port for the Node sidecar.
SCRATCH_MCP_BRIDGE_PORT=9060
